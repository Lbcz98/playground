{
  "name": "playground-web",
  "private": true,
  "version": "0.1.0",
  "description": "Shared prototype app: one Next.js app, one folder per designer under protos/. Files only — no backend, no database.",
  "scripts": {
    "dev": "next dev --webpack -p 3000",
    "build": "next build --webpack",
    "start": "next start -p 3000",
    "build:tv": "BROWSERSLIST='chrome >= 68, safari >= 16' NEXT_DIST_DIR=.next-tv next build --webpack",
    "start:tv": "NEXT_DIST_DIR=.next-tv next start -H 0.0.0.0 -p 3002",
    "tv": "npm run build:tv && npm run start:tv",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  }
}
