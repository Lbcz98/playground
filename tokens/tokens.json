        },
        "background-overlay": {
          "$value": "{color.opacity.base-rounded}",
          "$type": "color",
          "$description": "Translucent scrim behind modals/drawers"
        },
        "text-primary": {
          "$value": "{color.core.neutral.white}",
          "$type": "color",
          "$description": "Primary readable text on dark surfaces"
        },
        "text-secondary": {
          "$value": "{color.core.neutral.light-grey}",
          "$type": "color",
          "$description": "Subdued text, placeholders, captions"
        },
        "text-subtle": {
          "$value": "{color.core.neutral.grey-mid}",
          "$type": "color",
          "$description": "Supporting line under a title in the main menu and the dynamic carousel (Figma: color/functional/text-subtle)"
        },
        "text-inverse": {
          "$value": "{color.core.neutral.black}",
          "$type": "color",
          "$description": "Text on light/accent backgrounds"
        },
        "border-subtle": {
          "$value": "{color.opacity.light.10}",
          "$type": "color",
          "$description": "Low-contrast dividers on dark surfaces"
        },
        "border-default": {
          "$value": "{color.opacity.light.20}",
          "$type": "color",
          "$description": "Standard border on dark surfaces"
        },
        "status-error": {
          "$value": "{color.core.complementary.error}",
          "$type": "color"
        },
        "status-success": {
          "$value": "{color.core.complementary.confirmation}",
          "$type": "color"
        },
        "status-warning": {
          "$value": "{color.core.complementary.alert}",
          "$type": "color"
        },
        "status-live": {
          "$value": "{color.core.complementary.live}",
          "$type": "color"
        },
        "background-translucent": {
          "$value": "{color.opacity.background}",
          "$type": "color",
          "$description": "Resting card and control surface over video or imagery"
        },
        "background-tint": {
          "$value": "{color.opacity.light.10}",
          "$type": "color",
          "$description": "Faint light tint behind a resting status pill"
        },
        "text-muted": {
          "$value": "{color.opacity.light.70}",
          "$type": "color",
          "$description": "Supporting text on translucent cards (overline, subtitle)"
        }
      },
      "focus": {
        "inset": {
          "$value": "{color.opacity.dark.70}",
          "$type": "color",
          "$description": "Fill inside the focus ring"
        },
        "inset-fade": {
          "$value": "{color.core.neutral.charcoal}",
          "$type": "color",
          "$description": "Fade layered over the focus ring's inner fill"
        },
        "glow": {
          "$value": "{color.core.primary.noite.light}",
          "$type": "color",
          "$description": "Light pooling inside a focused control"
        },
        "outline": {
          "$value": "{color.semantic.theme.noite-dark}",
          "$type": "color",
          "$description": "Outside focus outline (CSS outline + offset) for content that fills its own hit target, like the channel bug. An outline can't carry the ring's gradient, so it takes the ring's dominant colour."
        }
      },
      "overlay": {
        "scrim": {
          "$value": "{color.opacity.dark.10}",
          "$type": "color",
          "$description": "Base legibility scrim over video or imagery. Every overlay except top-right lays it under its shade (Figma: Overlays)."
        }
      }
    }
  },
  "gradient": {
    "$description": "DTCG gradients carry no angle. CSS draws each one at 180deg (to bottom) unless the token sets $extensions[\"com.screenflow.css\"].angle.",
    "semantic": {
      "focus": {
        "ring": {
          "$type": "gradient",
          "$value": "{gradient.primary.noite}",
          "$description": "The one focus ring, shared by every focusable control"
        }
      },
      "border": {
        "default": {
          "$type": "gradient",
          "$value": "{gradient.complementary.diagonal-light}",
          "$description": "The one resting stroke on every interactive control: cards, pill buttons, round buttons"
        }
      },
      "status": {
        "live": {
          "$type": "gradient",
          "$value": "{gradient.complementary.live}",
          "$description": "Focused live-broadcast pill"
        },
        "replay": {
          "$type": "gradient",
          "$value": "{gradient.complementary.replay}",
          "$description": "Focused replay pill"
        }
      },
      "overlay": {
        "bottom": {
          "$type": "gradient",
          "$value": "{gradient.overlay.bottom}",
          "$description": "Shade behind content anchored to the bottom edge (Figma Overlays: ↓)"
        },
        "left": {
          "$type": "gradient",
          "$value": "{gradient.overlay.left}",
          "$description": "Shade behind a panel or list on the left (Figma Overlays: ←)"
        },
        "right": {
          "$type": "gradient",
          "$value": "{gradient.overlay.right}",
          "$description": "Shade behind a panel or list on the right (Figma Overlays: →)"
        },
        "bottom-right": {
          "$type": "gradient",
          "$value": "{gradient.overlay.bottom-right}",
          "$description": "Shade behind content in the bottom-right corner (Figma Overlays: ↘)"
        },
        "bottom-left": {
          "$type": "gradient",
          "$value": "{gradient.overlay.bottom-left}",
          "$description": "Shade behind content in the bottom-left corner (Figma Overlays: ↙)"
        },
        "top-right": {
          "$type": "gradient",
          "$value": "{gradient.overlay.top-right}",
          "$description": "Shade behind a notification in the top-right corner — the one overlay without the scrim (Figma Overlays: ↗ Notificação)"
        }
      }
    },
    "primary": {
      "noite": {
        "$type": "gradient",
        "$value": [
          { "color": "{color.core.primary.noite.dark}", "position": 0.3 },
          { "color": "{color.core.primary.noite.light}", "position": 1 }
        ]
      },
      "dia": {
        "$type": "gradient",
        "$value": [
          { "color": "{color.core.primary.dia.dark}", "position": 0.3 },
          { "color": "{color.core.primary.dia.light}", "position": 1 }
        ]
      },
      "tarde": {
        "$type": "gradient",
        "$value": [
          { "color": "{color.core.primary.tarde.dark}", "position": 0.3 },
          { "color": "{color.core.primary.tarde.light}", "position": 1 }
        ]
      }
    },
    "inverse": {
      "noite": {
        "$type": "gradient",
        "$value": [
          { "color": "{color.core.primary.noite.light}", "position": 0 },
          { "color": "{color.core.primary.noite.dark}", "position": 0.7 }
        ]
      },
      "dia": {
        "$type": "gradient",
        "$value": [
          { "color": "{color.core.primary.dia.light}", "position": 0 },
          { "color": "{color.core.primary.dia.dark}", "position": 1 }
        ]
      },
      "tarde": {
        "$type": "gradient",
        "$value": [
          { "color": "{color.core.primary.tarde.light}", "position": 0 },
          { "color": "{color.core.primary.tarde.dark}", "position": 0.7 }
        ]
      }
    },
    "complementary": {
      "shiny": {
        "$type": "gradient",
        "$value": [
          { "color": "{color.core.neutral.grey-mid}", "position": 0 },
          { "color": "{color.core.neutral.white}", "position": 1 }
        ]
      },
      "diagonal-light": {
        "$type": "gradient",
        "$value": [
          { "color": "{color.opacity.light.70}", "position": 0 },
          { "color": "{color.opacity.greymid-30}", "position": 0.6 }
        ],
        "$description": "135deg (top-left to bottom-right), confirmed by pixel-sampling the real Figma render (node 6038:18472): brightness falls off along both the top and the left edge, which only a diagonal produces. End stop is greymid-30, not black.",
        "$extensions": {
          "com.screenflow.css": { "angle": "135deg" }
        }
      },
      "linear-light": {
        "$type": "gradient",
        "$value": [
          { "color": "{color.core.neutral.white}", "position": 0 },
          { "color": "{color.core.neutral.white-alpha-0}", "position": 1 }
        ]
      },
      "dark": {
        "$type": "gradient",
        "$value": [
          { "color": "{color.core.neutral.dark-blue-grey-alpha-0}", "position": 0 },
          { "color": "{color.core.neutral.charcoal}", "position": 1 }
        ],
        "$description": "Transparent-to-opaque dark overlay: fades from fully transparent dark-blue-grey to charcoal, as in the Figma style Gradients/Complementary/Dark (which also applies 50% style-level opacity)"
      },
      "live": {
        "$type": "gradient",
        "$value": [
          { "color": "{color.core.complementary.live}", "position": 0 },
          { "color": "{color.core.complementary.error}", "position": 0.7 }
        ]
      },
      "replay": {
        "$type": "gradient",
        "$value": [
          { "color": "{color.core.complementary.replay-light}", "position": 0 },
          { "color": "{color.core.complementary.replay-dark}", "position": 0.7 }
        ]
      }
    },
    "overlay": {
      "$description": "Black shades that keep content legible over video — the shade pieces of the layer rule (Camadas). Angles and stops come from the Figma Sombras pieces (node 2072:6605), the standard the Overlays component (3730:7871) and the screen models share: their gradient transforms, converted to CSS and checked against the render.",
      "bottom": {
        "$type": "gradient",
        "$value": [
          { "color": "{color.core.neutral.black-alpha-0}", "position": 0.5 },
          { "color": "{color.opacity.dark.90}", "position": 0.9 }
        ]
      },
      "left": {
        "$type": "gradient",
        "$value": [
          { "color": "{color.core.neutral.black-alpha-0}", "position": 0.5745 },
          { "color": "{color.opacity.dark.60}", "position": 0.9716 }
        ],
        "$extensions": { "com.screenflow.css": { "angle": "270deg" } }
      },
      "right": {
        "$type": "gradient",
        "$value": [
          { "color": "{color.core.neutral.black-alpha-0}", "position": 0.5745 },
          { "color": "{color.opacity.dark.60}", "position": 0.9716 }
        ],
        "$extensions": { "com.screenflow.css": { "angle": "90deg" } }
      },
      "bottom-right": {
        "$type": "gradient",
        "$value": [
          { "color": "{color.core.neutral.black-alpha-0}", "position": 0.5952 },
          { "color": "{color.core.neutral.black}", "position": 0.9579 }
        ],
        "$extensions": { "com.screenflow.css": { "angle": "134.57deg" } }
      },
      "bottom-left": {
        "$type": "gradient",
        "$value": [
          { "color": "{color.core.neutral.black-alpha-0}", "position": 0.5952 },
          { "color": "{color.core.neutral.black}", "position": 0.9579 }
        ],
        "$extensions": { "com.screenflow.css": { "angle": "225.43deg" } }
      },
      "top-right": {
        "$type": "gradient",
        "$value": [
          { "color": "{color.core.neutral.black-alpha-0}", "position": 0.7015 },
          { "color": "{color.core.neutral.black}", "position": 0.9322 }
        ],
        "$extensions": { "com.screenflow.css": { "angle": "36.4deg" } }
      }
    }
  },
