    "spacing": {
      "core": {
        "none": { "$value": "0px", "$type": "dimension" },
        "3xs": { "$value": "4px", "$type": "dimension" },
        "2xs": { "$value": "8px", "$type": "dimension" },
        "xs": { "$value": "12px", "$type": "dimension" },
        "sm": { "$value": "16px", "$type": "dimension" },
        "md": { "$value": "20px", "$type": "dimension" },
        "lg": { "$value": "24px", "$type": "dimension" },
        "xl": { "$value": "32px", "$type": "dimension" },
        "2xl": { "$value": "40px", "$type": "dimension" },
        "3xl": { "$value": "48px", "$type": "dimension" },
        "4xl": { "$value": "64px", "$type": "dimension" },
        "5xl": { "$value": "80px", "$type": "dimension" },
        "6xl": { "$value": "96px", "$type": "dimension" }
      },
      "semantic": {
        "card-inset": {
          "$value": "{dimension.spacing.core.md}",
          "$type": "dimension",
          "$description": "Resting card padding. Figma-exact and internal to the card, so it may sit off the layout grid."
        },
        "card-inset-expanded": {
          "$value": "{dimension.spacing.core.lg}",
          "$type": "dimension",
          "$description": "Focused or selected card padding"
        }
      }
    },
    "size": {
      "$type": "dimension",
      "$description": "Component sizes. Where a size matches a spacing step it aliases it; the rest were measured off the Figma UI Kit, which has no sizing scale.",
      "semantic": {
        "icon-sm": { "$value": "{dimension.spacing.core.sm}", "$description": "Inline icon in a control or pill" },
        "icon-md": { "$value": "{dimension.spacing.core.md}", "$description": "Loading spinner in a wide button" },
        "icon-lg": { "$value": "{dimension.spacing.core.lg}", "$description": "Card check mark, partner logo height, large-button icon" },
        "icon-xl": { "$value": "{dimension.spacing.core.xl}", "$description": "Icon inside a focused round button" },
        "icon-2xl": { "$value": "{dimension.spacing.core.2xl}", "$description": "Weather glyph in the main menu" },
        "icon-round-rest": { "$value": "28px", "$description": "Icon inside a resting round button (measured; no step matches)" },
        "control-height": { "$value": "{dimension.spacing.core.2xl}", "$description": "Pill button height" },
        "control-height-lg": { "$value": "{dimension.spacing.core.3xl}", "$description": "Large pill button height" },
        "wide-button-width": { "$value": "240px", "$description": "Figma UI Kit node 3386:10618" },
        "card-width": { "$value": "158px", "$description": "Resting card — Figma UI Kit node 2457:117489" },
        "card-height": { "$value": "122px", "$description": "Resting card" },
        "card-expanded-width": { "$value": "208px", "$description": "Focused or selected card" },
        "card-expanded-height": { "$value": "160px", "$description": "Focused or selected card" },
        "round-button": { "$value": "88px", "$description": "Round button hit target — Figma UI Kit node 2273:96230" },
        "round-button-circle": { "$value": "72px", "$description": "The visible circle inside a round button's hit target" },
        "avatar": { "$value": "{dimension.spacing.core.2xl}", "$description": "Profile avatar in the main menu" },
        "program-logo": { "$value": "{dimension.spacing.core.3xl}", "$description": "Live program logo in the main menu" },
        "channel-bug": { "$value": "{dimension.spacing.core.4xl}", "$description": "Channel bug in the main menu" }
      }
    },
    "border-width": {
      "core": {
        "hairline": { "$value": "1px", "$type": "dimension" },
        "thin": { "$value": "2px", "$type": "dimension" },
        "medium": { "$value": "4px", "$type": "dimension" },
        "thick": { "$value": "6px", "$type": "dimension" }
      },
      "semantic": {
        "card": {
          "$value": "{dimension.border-width.core.hairline}",
          "$type": "dimension"
        },
        "button": {
          "$value": "{dimension.border-width.core.hairline}",
          "$type": "dimension",
          "$description": "Snapped from 1.33–1.34px"
        },
        "section-focus": {
          "$value": "{dimension.border-width.core.thin}",
          "$type": "dimension"
        },
        "focus-ring": {
          "$value": "{dimension.border-width.core.medium}",
          "$type": "dimension"
        },
        "pill-focus": {
          "$value": "{dimension.border-width.core.thick}",
          "$type": "dimension"
        }
      }
    }
  },
