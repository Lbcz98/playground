          "$value": "{color.core.primary.dia.light}",
          "$type": "color",
          "$description": "Dia theme, light tone (Figma legacy variable: Dia-Claro)"
        },
        "tarde-dark": {
          "$value": "{color.core.primary.tarde.dark}",
          "$type": "color",
          "$description": "Tarde theme, dark tone (Figma legacy variable: Tarde-Escura)"
        },
