      "dark": {
        "10": { "$value": "#0000001A", "$type": "color" },
        "20": { "$value": "#00000033", "$type": "color" },
        "30": { "$value": "#0000004D", "$type": "color" },
        "50": { "$value": "#00000080", "$type": "color" },
