# Runs on every commit made by hand (scripts/deploy.ts commits with --no-verify: it has its own gate).
# A commit that touches no code, tokens or notes (docs only) skips the checks.
# With nvm or a GUI git client, put the PATH setup in ~/.config/husky/init.sh.
# A new `git worktree` has no .husky/_ (it is gitignored): run `npm run prepare` there once.
git diff --cached --name-only | grep -Eq '^(scripts|src|design-brain|web|tests|tokens|\.claude)/|^package(-lock)?\.json$' || exit 0
npm run typecheck && npm run lint:tokens && npx vitest run scripts
