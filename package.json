{
  "name": "screenflow-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Internal desktop app for building screen flows with a strict Design System and a built-in UI-generating AI agent.",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:tokens": "node scripts/check-tokens.mjs",
    "eval:modes": "vite-node --config vitest.config.ts eval/run.ts --",
    "tokens:build": "vite-node --config vitest.config.ts scripts/build-tokens.ts",
    "tokens:check": "vite-node --config vitest.config.ts scripts/build-tokens.ts -- --check",
    "tokens:audit": "vite-node --config vitest.config.ts scripts/audit-tokens.ts",
    "test:visual": "electron scripts/visual/regression.mjs",
    "test:visual:update": "electron scripts/visual/regression.mjs --update",
    "storybook": "storybook dev -p 6006",
    "storybook:manifest": "vite-node --config vitest.config.ts scripts/storybook/export-manifest.ts",
    "storybook:manifest:check": "vite-node --config vitest.config.ts scripts/storybook/export-manifest.ts -- --check",
    "dtv:export": "vite-node --config vitest.config.ts scripts/storybook/export-dtv.ts",
    "check:laws": "vite-node --config vitest.config.ts scripts/check-laws.ts --",
    "export:tsx": "vite-node --config vitest.config.ts scripts/export-tsx.ts --",
    "build-storybook": "storybook build",
    "browsers:install": "playwright install chromium"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@fontsource-variable/inter": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-mcp": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.3.1",
    "playwright": "^1.56.0",
    "postcss": "^8.4.49",
    "storybook": "^10.6.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^2.1.9"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "electron@33.4.11": true,
    "esbuild@0.21.5": true,
    "fsevents@2.3.3": true
  }
}
