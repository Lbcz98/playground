{
  "name": "screenflow-studio",
  "version": "0.1.0",
  "private": true,
  "description": "The DTV kit (primitives, components, tokens), the rules book and the checks for screens written as TSX. The shared prototype app lives in web/.",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:checks": "vitest run tests/checks",
    "lint:tokens": "node scripts/check-tokens.mjs",
    "tokens:build": "vite-node --config vitest.config.ts scripts/build-tokens.ts",
    "tokens:check": "vite-node --config vitest.config.ts scripts/build-tokens.ts -- --check && npm run guides:check",
    "guides:build": "vite-node --config vitest.config.ts scripts/build-guides.ts",
    "guides:check": "vite-node --config vitest.config.ts scripts/build-guides.ts -- --check",
    "tokens:audit": "vite-node --config vitest.config.ts scripts/audit-tokens.ts",
    "storybook": "storybook dev -p 6006",
    "storybook:manifest": "vite-node --config vitest.config.ts scripts/storybook/export-manifest.ts",
    "storybook:manifest:check": "vite-node --config vitest.config.ts scripts/storybook/export-manifest.ts -- --check",
    "dtv:export": "vite-node --config vitest.config.ts scripts/storybook/export-dtv.ts",
    "explore:serve": "node scripts/explore-server.mjs --",
    "explore:status": "node scripts/explore-status.mjs --",
    "deploy": "vite-node --config vitest.config.ts scripts/deploy.ts --",
    "nearest-token": "vite-node --config vitest.config.ts scripts/nearest-token.ts --",
    "check:laws": "vite-node --config vitest.config.ts scripts/check-laws-cli.ts --",
    "ci:protos": "vite-node --config vitest.config.ts scripts/protos-ci.ts --",
    "check:flow": "vite-node --config vitest.config.ts scripts/flow-probe.ts --",
    "pr:report": "vite-node --config vitest.config.ts scripts/pr-report.ts --",
    "pr:comment": "vite-node --config vitest.config.ts scripts/post-pr-comment.ts --",
    "export:tsx": "vite-node --config vitest.config.ts scripts/export-tsx.ts --",
    "build-storybook": "storybook build",
    "browsers:install": "playwright install chromium",
    "dialkit:sync": "node scripts/sync-dialkit.mjs",
    "dialkit:check": "node scripts/sync-dialkit.mjs --check"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/addon-mcp": "^10.6.5",
    "@storybook/react-vite": "^10.6.5",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "0.28.2",
    "husky": "^9.1.7",
    "mesurer": "0.2.7",
    "playwright": "^1.64.0",
    "postcss": "^8.4.49",
    "storybook": "^10.6.5",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^8.3.5",
    "vite-node": "^6.0.0",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
