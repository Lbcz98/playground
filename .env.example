# Copy to .env. Read ONLY in the Electron main process — never bundled into the renderer.
#
# Provider selection:
#   auto (default) — use Claude Code if installed, else an API key, else the fixture
#   claude-cli     — force the local `claude` CLI (runs on your Pro/Max subscription)
#   api-key        — force the Anthropic API (metered, pay per use)
AI_PROVIDER=auto

# --- claude-cli provider (your Claude Code / subscription login) ---
# Only needed if `claude` is not on PATH (common for GUI apps on macOS):
CLAUDE_CLI_PATH=

# --- api-key provider ---
ANTHROPIC_API_KEY=

# Model + effort are normally chosen in the AI Agent panel (persisted per browser).
# These are only the fallback defaults if the panel hasn't set them:
AI_GENERATOR_MODEL=claude-opus-5
AI_CLI_MODEL=
AI_EFFORT=medium

# Orchestration pipeline: how many times the Generator may retry after the
# main-process Zod validator rejects its output (0–4, default 2).
AI_MAX_VALIDATION_RETRIES=2

# Skills (skills/<name>/SKILL.md) whose full text closes the Generator's system
# prompt, comma-separated. Empty: none, and every prompt is unchanged. An unknown
# name is an error. The eval stamps the list on every result.
SFS_SKILLS=
